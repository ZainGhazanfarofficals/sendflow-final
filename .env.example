# Database (auto-configured if using Docker Compose — do not change)
DATABASE_URL=postgresql://postgres:1998@db:5432/docpad

# NextAuth — generate a secret: openssl rand -hex 32
NEXTAUTH_SECRET=your_random_secret_here
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_URL=http://localhost:3000/

# Stripe (get from stripe.com dashboard)
NEXT_PUBLIC_API_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...

# Google OAuth (get from console.cloud.google.com)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback/google

# Email / SMTP sender account
EMAIL_SENDER=your_gmail@gmail.com
EMAIL_SENDER_APP_PASSWORD=your_gmail_app_password
EMAIL_SENDER_NAME=Sendflow
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
